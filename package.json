{
  "name": "fit-coach-backend",
  "version": "0.1.0",
  "description": "Backend for Fit Coach Portal — coach/client management, plans, progress tracking, subscriptions",
  "main": "src/server.js",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "create-indexes": "node src/scripts/CreateIndexes.js",
    "create-admin": "node src/scripts/CreateAdmin.js",
    "seed:exercises": "node src/scripts/seedExercises.js",
    "seed:food": "node src/scripts/seedFoodItems.js",
    "seed:indian-foods": "node src/scripts/seedIndianFoods.js",
    "seed:all": "node src/scripts/seedExercises.js && node src/scripts/seedFoodItems.js && node src/scripts/seedIndianFoods.js",
    "expire-subscriptions": "node src/jobs/subscriptions.job.js",
    "lint": "eslint . --ext .js",
    "test": "echo \"No tests specified\" && exit 0"
  },
  "keywords": [
    "herbalife",
    "coach",
    "health",
    "backend",
    "mern",
    "coaching"
  ],
  "author": "CodeShowOff",
  "license": "MIT",
  "dependencies": {
    "@getbrevo/brevo": "^3.0.1",
    "bcrypt": "^6.0.0",
    "cloudinary": "^2.8.0",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^17.2.3",
    "express": "^5.1.0",
    "express-async-handler": "^1.2.0",
    "express-mongo-sanitize": "^2.2.0",
    "express-rate-limit": "^8.2.1",
    "express-xss-sanitizer": "^2.0.1",
    "helmet": "^8.1.0",
    "joi": "^18.0.1",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.20.0",
    "morgan": "^1.10.1",
    "multer": "^2.0.2",
    "node-cron": "^3.0.3",
    "pdfkit": "^0.15.0",
    "rate-limit-redis": "^4.2.3",
    "redis": "^5.9.0",
    "sanitize-html": "^2.17.0",
    "socket.io": "^4.8.1",
    "streamifier": "^0.1.1"
  },
  "devDependencies": {
    "@eslint/config-array": "^0.23.0",
    "@eslint/js": "^9.39.0",
    "@eslint/object-schema": "^3.0.0",
    "eslint": "^9.39.1",
    "glob": "^13.0.0",
    "globals": "^16.5.0",
    "rimraf": "^6.1.2"
  }
}
